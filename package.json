{
  "name": "ruby-nav",
  "displayName": "Ruby Navigation",
  "publisher": "alysontrizotto",
  "author": {
    "name": "Alyson Trizotto",
    "email": "alysontrizotto1@gmail.com"
  },
  "description": "Ruby/Rails navigation: go-to-definition and find-references (AST-based).",
  "icon": "images/logo.png",
  "version": "1.6.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alysontrizotto/ruby-nav-pro"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:ruby",
    "onLanguage:erb"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "RubyNav",
      "properties": {
        "rubyNav.debug": {
          "type": "boolean",
          "default": false,
          "description": "Regista pedidos/respostas JSON e stderr Ruby no painel View → Output (canal \"RubyNav\"). Não usa \"Developer: Show Logs\"."
        }
      }
    },
    "commands": [
      {
        "command": "rubyNav.showOutput",
        "title": "RubyNav: Mostrar registo / log (Output)",
        "category": "RubyNav"
      },
      {
        "command": "rubyNav.goToDefinitionManual",
        "title": "Ruby: Go to Definition (Manual)"
      },
      {
        "command": "rubyNav.showReferences",
        "title": "Ruby: Show References"
      },
      {
        "command": "rubyNav.reindexWorkspace",
        "title": "Ruby: Re-indexar Workspace"
      }
    ],
    "keybindings": [
      {
        "command": "rubyNav.goToDefinitionManual",
        "key": "ctrl+d",
        "when": "editorTextFocus && editorLangId == 'ruby'"
      },
      {
        "command": "rubyNav.showReferences",
        "key": "ctrl+shift+d",
        "when": "editorTextFocus && editorLangId == 'ruby'"
      }
    ],
    "languages": [
      {
        "id": "ruby",
        "aliases": [
          "Ruby",
          "ruby"
        ],
        "extensions": [
          ".rb",
          ".rake",
          ".gemspec",
          ".ru",
          ".erb"
        ],
        "configuration": "./syntaxes/ruby.tmLanguage.json"
      }
    ]
  }
}